# tod_release.cmake -- per-release guest addresses and the hooks into the lifted code.
#
# The port names the game's code by its address in the European release (BCES00052 1.00). Other releases have
# the same code at other addresses; versions/addresses.tsv lists, for every address the port uses, the address
# in each supported release (checked with tools/tod-fnmap). TOD_RELEASE picks the column:
#
#   tod_release_load()      sets TODA_<eu> = this release's address (8 hex digits) for every row, and writes
#                           gen/tod_release.h: TOD_A_<eu> for every row and TOD_H_<role> for every hook, which
#                           src/release/tod_addr.h turns into function names and numbers.
#   tod_patch_lift(<var> <eu address>...)
#                           renames the lifted definition of each hook to func_<addr>_lifted (the port defines
#                           func_<addr> and calls the lifted body), whichever lifted unit holds it; 001E4CC0 in the
#                           list applies the armor/helmet body patches to the per-frame hero update instead (it is not
#                           renamed). Every listed address must be found. <var> is the list of lifted
#                           sources; the units it changes are replaced by patched copies in gen/ppu_hooks/.
#
# With TOD_RELEASE=BCES00052 every TODA_<eu> is <eu> and the patched units are what the per-hook
# tools/*_ppu_patch.cmake chain produced before.

set(TOD_RELEASE "BCES00052" CACHE STRING "Release the lift comes from: BCES00052 (EU 1.00) or BCUS98127 (NA, disc 02.00)")
set_property(CACHE TOD_RELEASE PROPERTY STRINGS BCES00052 BCUS98127)

function(tod_release_load)
    set(table "${CMAKE_CURRENT_SOURCE_DIR}/versions/addresses.tsv")
    if(TOD_RELEASE STREQUAL "BCES00052")
        set(col 0)
    elseif(TOD_RELEASE STREQUAL "BCUS98127")
        set(col 1)
    else()
        message(FATAL_ERROR "TOD_RELEASE=${TOD_RELEASE}: use BCES00052 or BCUS98127")
    endif()
    file(STRINGS "${table}" lines)
    set(h "/* Generated by tools/tod_release.cmake from versions/addresses.tsv for ${TOD_RELEASE}. */\n#pragma once\n#define TOD_RELEASE_ID \"${TOD_RELEASE}\"\n")
    set(n 0)
    foreach(line IN LISTS lines)
        if(line MATCHES "^#" OR line MATCHES "^eu\t")
            continue()
        endif()
        string(REPLACE "\t" ";" f "${line}")
        list(LENGTH f nf)
        if(nf LESS 3)
            continue()
        endif()
        list(GET f 0 eu)
        list(GET f ${col} a)
        set(role "")
        if(nf GREATER 3)
            list(GET f 3 role)
        endif()
        set(TODA_${eu} "${a}" PARENT_SCOPE)
        string(APPEND h "#define TOD_A_${eu} ${a}\n")
        if(role)
            string(APPEND h "#define TOD_H_${role} ${a}\n")
        endif()
        math(EXPR n "${n} + 1")
    endforeach()
    set(out "${CMAKE_BINARY_DIR}/gen/tod_release.h")
    set(old "")
    if(EXISTS "${out}")
        file(READ "${out}" old)
    endif()
    if(NOT old STREQUAL h)
        file(WRITE "${out}" "${h}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${table}")
    message(STATUS "Release:         ${TOD_RELEASE} (${n} addresses from versions/addresses.tsv)")
endfunction()

# The armor/helmet patches of the per-frame hero update (TOD_REMOVE_HELMET, barefoot; src/stubs/armor_look.cpp):
# the head-group read of hero+0x21CD and the one write of the visible mesh groups (moby+0x118) go through the port.
function(tod_armor_body_patch txtvar unit)
    set(txt "${${txtvar}}")
    set(hdef "void func_${TODA_001E4CC0}(ppu_context* ctx) {\n")
    set(hrd "        r9 = vm_read8(r31 + 0x21CD);\n")
    string(FIND "${txt}" "${hdef}" hpos)
    string(FIND "${txt}" "${hrd}" rpos)
    string(FIND "${txt}" "${hrd}" rlast REVERSE)
    if(hpos LESS 0 OR rpos LESS hpos OR NOT rpos EQUAL rlast)
        message(FATAL_ERROR "tod_patch_lift: ${unit}: helmet read in func_${TODA_001E4CC0} not found exactly once")
    endif()
    string(REPLACE "${hrd}" "        r9 = tod_helmet_flag(vm_read8(r31 + 0x21CD));\n" txt "${txt}")
    string(REPLACE "${hdef}" "uint64_t tod_helmet_flag(uint64_t v);\nuint64_t tod_hero_mesh_mask(uint32_t moby, uint64_t mask);\n${hdef}" txt "${txt}")
    set(mwr "        vm_write64(r9 + 0x118, r5);\n")
    string(FIND "${txt}" "${hdef}" hpos2)
    string(SUBSTRING "${txt}" ${hpos2} -1 tail)
    string(FIND "${tail}" "${mwr}" mrel)
    string(FIND "${tail}" "\nvoid func_" nextf)
    if(mrel LESS 0 OR (nextf GREATER 0 AND mrel GREATER nextf))
        message(FATAL_ERROR "tod_patch_lift: ${unit}: mesh mask write in func_${TODA_001E4CC0} not found")
    endif()
    math(EXPR mpos "${hpos2} + ${mrel}")
    string(SUBSTRING "${txt}" 0 ${mpos} head)
    string(LENGTH "${mwr}" mlen)
    math(EXPR mafter "${mpos} + ${mlen}")
    string(SUBSTRING "${txt}" ${mafter} -1 rest)
    set(${txtvar} "${head}        vm_write64(r9 + 0x118, tod_hero_mesh_mask((uint32_t)r9, r5));\n${rest}" PARENT_SCOPE)
endfunction()

function(tod_patch_lift srcvar)
    set(pending ${ARGN})
    set(result "")
    foreach(src IN LISTS ${srcvar})
        if(NOT src MATCHES "ppu_recomp_[0-9]+\\.cpp$")
            list(APPEND result "${src}")
            continue()
        endif()
        file(READ "${src}" txt)
        set(done "")
        foreach(eu IN LISTS pending)
            if(eu STREQUAL "001E4CC0")   # the hero update: patched in place below, not renamed
                continue()
            endif()
            set(a "${TODA_${eu}}")
            if(NOT a)
                message(FATAL_ERROR "tod_patch_lift: ${eu} is not in versions/addresses.tsv")
            endif()
            set(def "void func_${a}(ppu_context* ctx) {")
            string(FIND "${txt}" "${def}" pos)
            if(pos GREATER -1)
                string(REPLACE "${def}" "void func_${a}_lifted(ppu_context* ctx) {" txt "${txt}")
                list(APPEND done ${eu})
            endif()
        endforeach()
        # the hero update itself is not renamed, only patched in place
        set(hpos -1)
        if("001E4CC0" IN_LIST pending)
            string(FIND "${txt}" "void func_${TODA_001E4CC0}(ppu_context* ctx) {\n" hpos)
        endif()
        if(hpos GREATER -1)
            tod_armor_body_patch(txt "${src}")
            list(APPEND done 001E4CC0)
        endif()
        if(done)
            if(pending)
                list(REMOVE_ITEM pending ${done})
            endif()
            get_filename_component(name "${src}" NAME)
            set(outc "${CMAKE_BINARY_DIR}/gen/ppu_hooks/${name}")
            set(old "")
            if(EXISTS "${outc}")
                file(READ "${outc}" old)
            endif()
            if(NOT old STREQUAL txt)
                file(WRITE "${outc}" "${txt}")
            endif()
            list(JOIN done " " dl)
            message(STATUS "  hooks in ${name}: ${dl}")
            list(APPEND result "${outc}")
        else()
            list(APPEND result "${src}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${src}")
    endforeach()
    if(pending)
        list(JOIN pending " " pl)
        message(FATAL_ERROR "tod_patch_lift: no lifted definition for ${pl} (release ${TOD_RELEASE}: is the lift from that release?)")
    endif()
    set(${srcvar} "${result}" PARENT_SCOPE)
endfunction()
